# Supported modes: reference or ai.
VIVASIGN_EVALUATION_MODE=reference

# Comma-separated browser origins allowed to access the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI evaluation mode requires PostgreSQL and Gemini configuration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
